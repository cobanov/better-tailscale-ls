#!/usr/bin/env bash
# tsls - colorful Tailscale device list
# Usage:
#   tsls              show your devices (Mullvad + shared-in nodes hidden)
#   tsls -o           online only
#   tsls -f           offline only
#   tsls -a           also show Mullvad exit nodes and shared-in (sharee) nodes
#   tsls -w [sec]     watch mode (default 5s refresh)
#   tsls -u           update to the latest release
#   tsls -V           print version

set -euo pipefail

VERSION="0.4.3"
REPO="cobanov/better-tailscale-ls"

ONLINE_ONLY=0
OFFLINE_ONLY=0
SHOW_ALL=0
WATCH=0
WATCH_INTERVAL=5

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--online)  ONLINE_ONLY=1; OFFLINE_ONLY=0; shift ;;
    -f|--offline) OFFLINE_ONLY=1; ONLINE_ONLY=0; shift ;;
    -a|--all)     SHOW_ALL=1; shift ;;
    -w|--watch)
      WATCH=1; shift
      if [[ ${1:-} =~ ^[1-9][0-9]*$ ]]; then WATCH_INTERVAL=$1; shift; fi
      ;;
    -u|--update|--upgrade) ACTION=update; shift ;;
    -V|--version) printf "tsls %s\n" "$VERSION"; exit 0 ;;
    -h|--help)
      sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 1 ;;
  esac
done
ACTION="${ACTION:-}"

[[ "$ACTION" == update ]] || command -v tailscale >/dev/null || { echo "tailscale not found in PATH" >&2; exit 1; }
command -v jq >/dev/null || { echo "jq not found in PATH (brew install jq)" >&2; exit 1; }

# ANSI helpers — balanced palette inspired by One Dark / Gruvbox
if [[ -t 1 ]]; then
  C_RESET=$'\033[0m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'
  C_GREEN=$'\033[38;5;114m'    # green
  C_RED=$'\033[38;5;168m'      # rose
  C_YELLOW=$'\033[38;5;179m'   # gold
  C_BLUE=$'\033[38;5;111m'     # sapphire
  C_MAGENTA=$'\033[38;5;141m'  # purple
  C_CYAN=$'\033[38;5;80m'      # cyan
  C_GREY=$'\033[38;5;245m'     # grey
  C_ORANGE=$'\033[38;5;215m'   # peach
else
  C_RESET=""; C_DIM=""; C_BOLD=""; C_GREEN=""; C_RED=""; C_YELLOW=""
  C_BLUE=""; C_MAGENTA=""; C_CYAN=""; C_GREY=""; C_ORANGE=""
fi

human_ago() {
  # input: ISO timestamp (render handles the 0001-01-01 zero time);
  # output: "5m", "3h", "2d"
  local ts="$1"
  local now epoch diff off=0
  now=$(date +%s)
  # Timestamps may carry a zone offset ("2026-06-12T15:11:05.2-07:00");
  # parsing those as UTC would skew the result by hours, so capture the
  # offset first and apply it to the epoch afterwards.
  case "$ts" in
    *[+-][0-9][0-9]:[0-9][0-9])
      local zone="${ts: -6}"
      off=$(( 10#${zone:1:2} * 3600 + 10#${zone:4:2} * 60 ))
      [[ "${zone:0:1}" == "-" ]] && off=$(( -off ))
      ;;
  esac
  # Bare "YYYY-MM-DDTHH:MM:SS" prefix; drops fraction, Z, and offset.
  local clean="${ts:0:19}"
  # BSD date (macOS) first, GNU date (Linux) as fallback.
  epoch=$(date -j -u -f "%Y-%m-%dT%H:%M:%S" "$clean" +%s 2>/dev/null \
       || date -u -d "$clean" +%s 2>/dev/null \
       || echo "$now")
  diff=$(( now - (epoch - off) ))
  (( diff < 0 )) && diff=0
  if   (( diff < 60 ));     then printf "%ds" "$diff"
  elif (( diff < 3600 ));   then printf "%dm" $((diff/60))
  elif (( diff < 86400 ));  then printf "%dh" $((diff/3600))
  elif (( diff < 2592000 ));then printf "%dd" $((diff/86400))
  else printf "%dmo" $((diff/2592000))
  fi
}

resolve_self() {
  # Follow symlinks to find the actual on-disk script path.
  local p="$0"
  while [[ -L "$p" ]]; do
    local t
    t=$(readlink "$p")
    [[ "$t" = /* ]] && p="$t" || p="$(cd "$(dirname "$p")" && pwd)/$t"
  done
  printf "%s\n" "$p"
}

self_update() {
  command -v curl >/dev/null || { echo "curl required for --update" >&2; exit 1; }
  local self tmp tag remote dl_url
  self=$(resolve_self)
  tmp=$(mktemp)
  # Covers every exit path, including an aborted sudo prompt. Expand
  # $tmp now: it is a local and out of scope when the trap fires.
  # shellcheck disable=SC2064
  trap "rm -f '$tmp'" EXIT

  printf "\n  %scurrent:%s %s\n" "$C_DIM" "$C_RESET" "$VERSION"
  printf "  %schecking:%s github.com/%s releases\n" "$C_DIM" "$C_RESET" "$REPO"

  # Resolve the latest release tag via the GitHub API. Release/tag URLs
  # are immutable, so raw.githubusercontent.com always serves them fresh
  # (unlike branch-based URLs, which the CDN caches aggressively).
  # `|| true` keeps a failed fetch from tripping errexit before the
  # empty-tag check below can print its message.
  tag=$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" \
        | jq -r '.tag_name // empty' 2>/dev/null || true)

  if [[ -z "$tag" ]]; then
    printf "  %s✗%s could not determine latest release (no releases yet?)\n" \
      "$C_RED" "$C_RESET" >&2
    exit 1
  fi

  remote="${tag#v}"

  # A local copy ahead of the release (installed from main before the
  # release went out) counts as latest, so -u never downgrades it.
  if [[ "$(printf '%s\n' "$remote" "$VERSION" | sort -V | tail -1)" == "$VERSION" ]]; then
    printf "  %s✓%s already on the latest version (%s)\n\n" \
      "$C_GREEN" "$C_RESET" "$VERSION"
    exit 0
  fi

  printf "  %s↑%s updating %s%s%s → %s%s%s\n" \
    "$C_GREEN" "$C_RESET" \
    "$C_DIM" "$VERSION" "$C_RESET" \
    "$C_BOLD" "$remote" "$C_RESET"

  dl_url="https://raw.githubusercontent.com/${REPO}/${tag}/tsls"
  if ! curl -fsSL "$dl_url" -o "$tmp"; then
    printf "  %s✗%s download failed: %s\n" "$C_RED" "$C_RESET" "$dl_url" >&2
    exit 1
  fi

  # Sanity check: the downloaded file should at least look like our script
  if ! head -1 "$tmp" | grep -q '^#!/usr/bin/env bash'; then
    printf "  %s✗%s downloaded file looks corrupted\n" "$C_RED" "$C_RESET" >&2
    exit 1
  fi

  if [[ -w "$self" ]]; then
    install -m 0755 "$tmp" "$self"
  else
    printf "  %sneed sudo to write %s%s\n" "$C_DIM" "$self" "$C_RESET"
    sudo install -m 0755 "$tmp" "$self"
  fi
  printf "  %s✓%s installed v%s at %s\n\n" "$C_GREEN" "$C_RESET" "$remote" "$self"
}

render() {
  local json
  if ! json=$(tailscale status --json 2>/dev/null) || [[ -z "$json" ]]; then
    printf "  %s✗%s cannot reach tailscaled (is Tailscale running?)\n" \
      "$C_RED" "$C_RESET" >&2
    return 1
  fi

  local backend
  backend=$(printf "%s" "$json" | jq -r '.BackendState // "Unknown"' 2>/dev/null || echo Unknown)
  if [[ "$backend" != "Running" && "$backend" != "Starting" ]]; then
    printf "  %s✗%s tailscale backend is %s (try: tailscale up)\n" \
      "$C_RED" "$C_RESET" "$backend" >&2
    return 1
  fi

  local tailnet
  tailnet=$(printf "%s" "$json" | jq -r '.MagicDNSSuffix // "tailnet"')

  # Build rows separated by \x1f (Unit Separator, non-whitespace so bash
  # `read` won't collapse empty fields the way it does with tabs).
  # Columns: online<US>hidden<US>name<US>ip<US>os<US>last<US>tag<US>caps<US>expired
  # `hidden` flags noise we suppress by default without dropping the row:
  # Mullvad-tagged exit nodes and ShareeNode entries (devices owned by
  # users we've shared a node *to* — Tailscale masks these behind the
  # placeholder hostname "device-of-shared-to-user"), except the exit node
  # in use, which always shows. "name" is the Tailscale machine name
  # (DNSName before first dot); falls back to HostName, then "?".
  # `caps` is a comma-separated list of capability flags: exit-opt, subnets.
  # Peers with an expired node key count as offline regardless of .Online,
  # which control keeps reporting as true for them.
  local US=$'\x1f'
  local rows
  rows=$(printf "%s" "$json" | jq -r --arg us "$US" '
    (.Self.ID // "") as $self
    | [ .Self ] + ( .Peer // {} | to_entries | map(.value) )
    | .[]
    | ( (.DNSName // "") | split(".") | .[0] ) as $name
    | ( (.Tags // []) | any(startswith("tag:mullvad")) ) as $is_mullvad
    | ( .ShareeNode // false ) as $is_sharee
    | ( .ID == $self ) as $is_self
    | ( .Expired // false ) as $expired
    | [
        (if .Online and ($expired | not) then "1" else "0" end),
        (if ($is_mullvad or $is_sharee) and (.ExitNode // false | not) then "1" else "0" end),
        # `//` only replaces null/false, so empty strings need their own test.
        (if ($name // "") != "" then $name
         elif (.HostName // "") != "" then .HostName
         else "?" end),
        (.TailscaleIPs[0] // "-"),
        (if (.OS // "") == "" then "-" else .OS end),
        (.LastSeen // "0001-01-01T00:00:00Z"),
        (if $is_self then "self"
         elif .ExitNode then "exit"
         # Engine sessions linger after a peer dies abruptly, so an
         # offline row claiming [active] is just a stale link entry.
         elif .Active and .Online and ($expired | not) then "active"
         else "" end),
        ([
          (if (.ExitNodeOption // false) and (.ExitNode // false | not) then "exit-opt" else empty end),
          (if ((.PrimaryRoutes // []) | length) > 0 then "subnets" else empty end)
        ] | join(",")),
        (if $expired then "1" else "0" end)
      ] | join($us)
  ')

  # Counts (visible-only respect SHOW_ALL)
  local total online offline hidden
  total=$(printf "%s\n" "$rows" | grep -c . || true)
  hidden=$(printf "%s\n" "$rows" | awk -F"$US" '$2=="1"' | wc -l | tr -d ' ')
  if [[ "$SHOW_ALL" == 1 ]]; then
    online=$(printf "%s\n" "$rows" | awk -F"$US" '$1=="1"' | wc -l | tr -d ' ')
    offline=$(( total - online ))
  else
    online=$(printf "%s\n" "$rows"  | awk -F"$US" '$1=="1" && $2=="0"' | wc -l | tr -d ' ')
    offline=$(printf "%s\n" "$rows" | awk -F"$US" '$1=="0" && $2=="0"' | wc -l | tr -d ' ')
  fi

  # Keep a plain (uncolored) copy of the header alongside so the
  # separator below can be sized to at least the header width.
  local head_plain="Tailscale  ${tailnet}  ·  ${online} online  ${offline} offline"
  printf "\n  %s%sTailscale%s  %s%s%s  ·  %s%s online%s  %s%s offline%s" \
    "$C_BOLD" "$C_CYAN" "$C_RESET" \
    "$C_DIM" "$tailnet" "$C_RESET" \
    "$C_GREEN" "$online" "$C_RESET" \
    "$C_GREY"  "$offline" "$C_RESET"
  if [[ "$SHOW_ALL" != 1 && "$hidden" -gt 0 ]]; then
    printf "  ·  %s%s hidden%s" "$C_DIM" "$hidden" "$C_RESET"
    head_plain+="  ·  ${hidden} hidden"
  fi
  printf "   %sv%s%s\n" "$C_DIM" "$VERSION" "$C_RESET"
  head_plain+="   v${VERSION}"

  # The rows that will print, filtered once so the widths and the loop
  # below agree. Sort: online (1) first, then OS so device types group
  # together, then by name within each group.
  local visible
  visible=$(printf "%s" "$rows" | LC_ALL=C sort -t"$US" -k1,1r -k5,5f -k3,3f \
    | awk -F"$US" -v all="$SHOW_ALL" -v on="$ONLINE_ONLY" -v off="$OFFLINE_ONLY" '
      all != 1 && $2 == "1" { next }
      on  == 1 && $1 != "1" { next }
      off == 1 && $1 != "0" { next }
      { print }')

  # Column widths adapt to the visible rows, so short names do not
  # leave a wall of padding behind them.
  local ipw namew osw
  read -r ipw namew osw <<< "$(printf "%s\n" "$visible" | awk -F"$US" '
    {
      if (length($4) > i) i = length($4)
      if (length($3) > n) n = length($3)
      if (length($5) > o) o = length($5)
    }
    END { printf "%d %d %d", i, n, o }')"

  # Separator spans the wider of the measured table and the header
  # line above it, capped at terminal width. The same rule is reused
  # as the divider between the online and offline groups.
  local cols width rule
  cols=$(tput cols 2>/dev/null || echo 80)
  width=$(( ipw + namew + osw + 19 ))
  (( ${#head_plain} > width )) && width=${#head_plain}
  (( width > cols - 4 )) && width=$(( cols - 4 ))
  (( width < 20 )) && width=20
  rule=$(printf '─%.0s' $(seq 1 "$width"))
  printf "  %s%s%s\n" "$C_DIM" "$rule" "$C_RESET"

  local prev_online=""
  while IFS="$US" read -r is_online _ name ip os last tag caps is_expired; do
    # The here-string yields one empty line when nothing matched.
    [[ -z "$name" ]] && continue

    # Divider where the online group ends and the offline group begins.
    if [[ "$prev_online" == "1" && "$is_online" != "1" ]]; then
      printf "  %s%s%s\n" "$C_DIM" "$rule" "$C_RESET"
    fi
    prev_online="$is_online"

    local dot status_col status_txt
    if [[ "$is_online" == "1" ]]; then
      dot="${C_GREEN}●${C_RESET}"
      status_col="$C_GREEN"; status_txt="online"
    elif [[ "$is_expired" == "1" ]]; then
      dot="${C_RED}○${C_RESET}"
      status_col="$C_RED"; status_txt="expired"
    else
      dot="${C_GREY}○${C_RESET}"
      status_col="$C_GREY"
      if [[ "$last" == 0001-01-01* ]]; then
        status_txt="offline"
      else
        status_txt="$(human_ago "$last") ago"
      fi
    fi

    local osc
    case "$os" in
      macOS|iOS) osc="$C_CYAN" ;;
      linux)     osc="$C_YELLOW" ;;
      windows)   osc="$C_BLUE" ;;
      android)   osc="$C_GREEN" ;;
      *)         osc="$C_MAGENTA" ;;
    esac

    local badge=""
    case "$tag" in
      self)   badge=" ${C_DIM}[self]${C_RESET}" ;;
      exit)   badge=" ${C_ORANGE}[exit]${C_RESET}" ;;
      active) badge=" ${C_GREEN}[active]${C_RESET}" ;;
    esac
    [[ "$caps" == *exit-opt* ]] && badge+=" ${C_DIM}[exit?]${C_RESET}"
    [[ "$caps" == *subnets* ]]  && badge+=" ${C_BLUE}[subnets]${C_RESET}"

    # Measured-width ip, name, os columns, then status and badges.
    printf "  %s  %s%-*s%s  %s%-*s%s  %s%-*s%s  %s%s%s%s\n" \
      "$dot" \
      "$C_DIM"  "$ipw"   "$ip"   "$C_RESET" \
      "$C_BOLD" "$namew" "$name" "$C_RESET" \
      "$osc"    "$osw"   "$os"   "$C_RESET" \
      "$status_col" "$status_txt" "$C_RESET" \
      "$badge"
  done <<< "$visible"

  printf "\n"
}

if [[ "$ACTION" == "update" ]]; then
  self_update
elif [[ "$WATCH" == 1 ]]; then
  # EXIT trap restores the cursor on every exit path, not just ctrl-c.
  trap 'tput cnorm 2>/dev/null' EXIT
  trap 'exit 0' INT TERM
  tput civis 2>/dev/null || true
  while true; do
    clear
    # A transient failure (tailscaled restarting) shows its message and
    # the next refresh retries instead of killing the watch.
    render || true
    printf "  %srefreshing every %ss · ctrl-c to quit%s\n" "$C_DIM" "$WATCH_INTERVAL" "$C_RESET"
    sleep "$WATCH_INTERVAL"
  done
else
  render
fi
